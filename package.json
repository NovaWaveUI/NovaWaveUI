{
  "name": "novawaveui",
  "version": "1.0.0",
  "description": "The base of the NovaWaveUI monorepo",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -w dlx turbo run build",
    "build:fast": "pnpm -w dlx turbo run build:fast",
    "dev": "pnpm -w dlx turbo run dev",
    "test": "pnpm -w dlx turbo run test",
    "lint": "pnpm -w dlx turbo run lint",
    "typeCheck": "pnpm -w dlx turbo run typeCheck",
    "clean": "pnpm -w dlx turbo run clean",
    "clean:dist": "pnpm -w dlx turbo run clean:dist",
    "storybook": "pnpm --filter storybook run storybook",
    "prepare": "husky",
    "create:headlessComponent": "plop headlessComponent",
    "create:component": "plop component",
    "create:reactLib": "plop reactLib",
    "create:lib": "plop lib",
    "create:hook": "plop hook"
  },
  "keywords": [
    "novawaveui",
    "react",
    "ui",
    "components",
    "design system",
    "headless"
  ],
  "author": "Kyle Gagnon",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@heroicons/react": "^2.2.0",
    "@iconify/react": "^6.0.2",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "husky": "^9.1.7",
    "plop": "^4.0.1",
    "storybook": "^9.1.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
