{
  "name": "@novawaveui/theme",
  "version": "1.0.0",
  "description": "The default theme configuration for NovaWaveUI",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./index.css",
    "./types": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist/",
    "index.css",
    "components/",
    "theme/",
    "package.json"
  ],
  "scripts": {
    "build": "vite build --mode production --minify terser",
    "build:fast": "vite build --mode development",
    "dev": "pnpm build:fast --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write . --ignore-path ../../../.prettierignore",
    "clean:dist": "rm -rf dist",
    "clean:node_modules": "rm -rf node_modules",
    "clean": "pnpm run clean:dist && pnpm run clean:node_modules",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "@tailwindcss/cli": "catalog:",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@novawaveui/eslint-config": "workspace:*",
    "@novawaveui/prettier-config": "workspace:*",
    "@novawaveui/typescript-config": "workspace:*",
    "@novawaveui/vite-config": "workspace:*",
    "@novawaveui/vitest-config": "workspace:*",
    "clean-package": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "theme",
    "ui",
    "novawaveui",
    "design",
    "system",
    "tailwindcss",
    "tailwind"
  ],
  "clean-package": "clean-package.config.json",
  "author": "Kyle Gagnon",
  "license": "MIT"
}
