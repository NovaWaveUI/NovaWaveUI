{
	"name": "@novawaveui/headless-button",
	"version": "1.0.0",
	"description": "A headless button",
	"keywords": [],
	"author": "Kyle Gagnon <kmgagnon99@gmail.com>",
	"license": "MIT",
	"type": "module",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts",
			"require": "./src/index.ts"
		}
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "vite build --mode production --minify terser",
		"build:fast": "vite build --mode environment",
		"dev": "pnpm build:fast --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"lint": "eslint . --ext .ts,.tsx",
		"format": "prettier --write . --ignore-path ../../.prettierignore",
		"prepack": "clean-package",
		"postpack": "clean-package restore",
		"clean:dist": "rm -rf dist",
		"clean:node_modules": "rm -rf node_modules",
		"clean": "pnpm run clean:dist && pnpm run clean:node_modules"
	},
	"peerDependencies": {
		"react": ">=19.2.3",
		"react-dom": ">=19.2.3"
	},
	"dependencies": {
		"@novawaveui/react-utils": "workspace:*"
	},
	"devDependencies": {
		"@novawaveui/eslint-config": "workspace:*",
		"@novawaveui/prettier-config": "workspace:*",
		"@novawaveui/typescript-config": "workspace:*",
		"@novawaveui/vite-config": "workspace:*",
		"@novawaveui/vitest-config": "workspace:*",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"clean-package": "catalog:",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"vite": "catalog:"
	},
	"clean-package": "../../../build/clean-package.config.json"
}
